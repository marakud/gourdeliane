// CartableFlow -- schéma Prisma initial (Story 1.1)
// Un seul modèle : User (id uniquement, pas de champ auth -- pas d'écran de connexion).
// Ce fichier est le schéma de DEV LOCAL (provider "sqlite"). Prisma n'autorise pas de
// provider dynamique via env() sur un datasource : le pendant production (Postgres /
// Supabase) vit dans prisma/schema.production.prisma et doit rester synchronisé avec
// celui-ci (seul le "provider" du datasource diffère). Voir README / .env.example.
// Les modèles des epics suivants (Subject, ScheduleSlot, ...) arrivent en Story 1.2+.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion ne vit plus dans le schéma (elle est fournie
// via prisma.config.ts pour le CLI, et via un driver adapter pour le runtime --
// voir data/prisma.ts). Voir https://pris.ly/d/prisma7-client-config
datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
