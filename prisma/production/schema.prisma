// CartableFlow -- miroir de prisma/schema.prisma pour la production (Postgres / Supabase).
// Utilisé par le pipeline de déploiement Vercel :
//   npx prisma generate --schema=prisma/production/schema.prisma
//   npx prisma migrate deploy --schema=prisma/production/schema.prisma
// Vit dans son propre dossier (avec ses propres migrations en sibling) car Prisma
// verrouille le provider d'un dossier de migrations dans migration_lock.toml --
// partager prisma/migrations/ avec le schéma SQLite de dev provoque l'erreur P3019
// ("datasource provider ... does not match ... migration_lock.toml").
// Garder ce fichier synchronisé avec prisma/schema.prisma (seul le "provider" du
// datasource change). Voir README / .env.example pour le détail du pipeline.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion ne vit plus dans le schéma (voir schema.prisma).
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  subjects                    Subject[]
  scheduleSlots               ScheduleSlot[]
  noSchoolDays                NoSchoolDay[]
  subjectItems                SubjectItem[]
  checklistItemStates         ChecklistItemState[]
  fixedChecklistItems         FixedChecklistItem[]
  fixedChecklistDefaultsSeeds FixedChecklistDefaultsSeed[]
}

// Jour de la semaine d'un créneau récurrent. Pas d'alternance A/B (PRD
// confirmé, Deferred par l'architecture) : un créneau vaut pour toutes les
// semaines, identifié uniquement par ce jour + horaire, jamais par une date.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Une matière. `colorIndex` est assigné une fois pour toutes à la création
// (domain/schedule.ts::assignNextColorIndex) et n'est jamais recalculé,
// même si d'autres matières sont supprimées ensuite (AD-6). Palette
// subject-1..8 de DESIGN.md, cyclique au-delà de 8 matières.
model Subject {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  colorIndex Int
  createdAt  DateTime @default(now())

  scheduleSlots ScheduleSlot[]
  items         SubjectItem[]

  // Une matière est réutilisée par son nom : deux créneaux sur "Maths"
  // partagent la même Subject, jamais une doublée.
  @@unique([userId, name])
}

// Un créneau hebdomadaire récurrent (jour + horaire + matière), identique
// chaque semaine -- pas de date, pas d'alternance A/B. Horaires stockés en
// String "HH:mm" (tri lexicographique correct dans ce format) : il n'y a pas
// de notion de date pour un créneau récurrent (voir Design Notes spec 1.2).
//
// Décision d'implémentation (I/O matrix spec 1.2, "Suppression d'une matière
// avec créneaux") : suppression en cascade -- supprimer une Subject supprime
// ses ScheduleSlot. Aucune UI de suppression directe de matière n'existe en
// Story 1.2 (seule la création à la volée depuis le formulaire de créneau
// est exposée) ; ce choix garde l'intégrité référentielle simple pour le
// jour où une telle UI arrivera (Réglages, epics suivants).
model ScheduleSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weekday   Weekday
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  @@index([userId, weekday])
}

// Un jour marqué "sans cours" par date précise (ex. jour férié, vacances),
// mémorisé indépendamment des créneaux hebdomadaires récurrents -- jamais
// dérivé (voir Design Notes spec 1.2). `date` est normalisée à minuit UTC
// par la couche data/ avant écriture/lecture ; clé unique (userId, date)
// pour rendre le marquage idempotent.
model NoSchoolDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Un objet par défaut associé à une matière (ex. "EPS" -> "Tenue de sport",
// FR-4, Story 2.1). Géré depuis Réglages ; éditer/supprimer un objet
// s'applique à toutes les occurrences futures de cette matière -- aucune
// checklist n'est jamais stockée par jour (AD-2, domain/checklist.ts).
// Modifier `label` ne touche jamais un `ChecklistItemState` déjà coché pour
// cet objet (AD-3) : celui-ci le référence par `id`, jamais par libellé.
model SubjectItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  label     String
  createdAt DateTime @default(now())

  @@index([userId, subjectId])
}

// État coché d'un item de checklist, keyé par identité stable -- jamais par
// libellé (AD-3). `date` est le jour POUR lequel la checklist est préparée
// (demain pour le sac), pas le jour de consultation (Design Notes spec 2.1).
// `checklistType` ("SAC" pour cette story) et `sourceType` ("SUBJECT_ITEM"
// pour cette story) sont écrits en toutes lettres en `String` plutôt qu'en
// enum Prisma : les stories suivantes (Matin/Retour/Révisions, Devoirs)
// réutiliseront ce même modèle avec d'autres valeurs plutôt que d'introduire
// une nouvelle table -- voir domain/checklist.ts pour les constantes
// applicatives correspondantes. Aucune tâche planifiée ne réinitialise cette
// table : le "reset quotidien" du sac vient du fait que `date` change d'un
// jour à l'autre, jamais d'un cron (cf. Never de la spec 2.1).
model ChecklistItemState {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  checklistType String
  sourceType    String
  sourceId      String
  checked       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date, checklistType, sourceType, sourceId])
}

// Un item d'une checklist fixe (Matin ici, Retour en Story 2.3), liste plate
// par utilisateur -- pas liée à une matière, contrairement à `SubjectItem`
// (spec 2.2). Scopée par `checklistType` ("MATIN"/"RETOUR") écrit en toutes
// lettres en `String`, même convention que `ChecklistItemState.checklistType`
// (domain/checklist.ts). Éditer `label` ne touche jamais un
// `ChecklistItemState` déjà coché pour cet item (AD-3) : celui-ci le
// référence par `id`, jamais par libellé -- identique à `SubjectItem`.
model FixedChecklistItem {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistType String
  label         String
  createdAt     DateTime @default(now())

  @@index([userId, checklistType])
}

// Marqueur "les défauts ont déjà été pré-remplis une fois" pour un
// utilisateur + `checklistType` -- distinct de `FixedChecklistItem` lui-même
// (spec 2.2, Boundaries/I-O matrix : le pré-remplissage n'a lieu qu'à la
// toute première consultation, jamais recréé si l'utilisateur a depuis tout
// supprimé). Sans ce marqueur, "aucun FixedChecklistItem pour ce type" ne
// permettrait pas de distinguer ces deux cas -- tous deux se traduisent par
// zéro ligne dans `FixedChecklistItem`. Une ligne ici est écrite une seule
// fois (à la création des défauts) et n'est jamais mise à jour ni supprimée,
// y compris si l'utilisateur supprime ensuite tous ses `FixedChecklistItem`.
model FixedChecklistDefaultsSeed {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistType String
  createdAt     DateTime @default(now())

  @@unique([userId, checklistType])
}
