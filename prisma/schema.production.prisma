// CartableFlow -- miroir du schema.prisma pour la production (Postgres / Supabase).
// Utilisé par le pipeline de déploiement Vercel :
//   npx prisma generate --schema=prisma/schema.production.prisma
//   npx prisma migrate deploy --schema=prisma/schema.production.prisma
// Garder ce fichier synchronisé avec prisma/schema.prisma (seul le "provider" du
// datasource change). Voir README / .env.example pour le détail du pipeline.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion ne vit plus dans le schéma (voir schema.prisma).
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
