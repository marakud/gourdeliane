# --- DEV LOCAL (SQLite, prisma/schema.prisma) ---
# Chemin vers le fichier SQLite local. Fonctionne tel quel, sans installation
# de base de données.
DATABASE_URL="file:./dev.db"

# --- PRODUCTION (Postgres / Supabase, prisma/production/schema.prisma) ---
# Sur Vercel, remplacer DATABASE_URL par la chaîne de connexion Postgres fournie
# par Supabase (Project Settings > Database > Connection string > URI), par ex. :
# DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require"
#
# Le build de production doit générer le client et appliquer les migrations avec
# le schéma Postgres explicitement (voir README) :
#   npx prisma generate --schema=prisma/production/schema.prisma
#   npx prisma migrate deploy --schema=prisma/production/schema.prisma
#
# Si DATABASE_URL est absente en production, le build/déploiement doit échouer
# explicitement (comportement par défaut de `prisma migrate deploy`).
