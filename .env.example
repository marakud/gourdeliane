# --- DEV LOCAL (SQLite, prisma/schema.prisma) ---
# Chemin vers le fichier SQLite local. Fonctionne tel quel, sans installation
# de base de donnees.
DATABASE_URL="file:./dev.db"

# --- PRODUCTION (Postgres / Supabase, prisma/schema.production.prisma) ---
# Sur Vercel, remplacer DATABASE_URL par la chaine de connexion Postgres fournie
# par Supabase (Project Settings > Database > Connection string > URI), par ex. :
# DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require"
#
# Le build de production doit generer le client et appliquer les migrations avec
# le schema Postgres explicitement (voir README) :
#   npx prisma generate --schema=prisma/schema.production.prisma
#   npx prisma migrate deploy --schema=prisma/schema.production.prisma
#
# Si DATABASE_URL est absente en production, le build/deploiement doit echouer
# explicitement (comportement par defaut de `prisma migrate deploy`).
