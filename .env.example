# --- DEV LOCAL (SQLite, prisma/schema.prisma) ---
# Chemin vers le fichier SQLite local. Fonctionne tel quel, sans installation
# de base de données.
DATABASE_URL="file:./dev.db"

# --- PRODUCTION (Postgres / Supabase, prisma/production/schema.prisma) ---
# Sur Vercel, remplacer DATABASE_URL par la chaîne de connexion Postgres fournie
# par Supabase (Project Settings > Database > Connection string > URI), par ex. :
# DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require"
#
# Le build de production doit générer le client et appliquer les migrations avec
# le schéma Postgres explicitement (voir README) :
#   npx prisma generate --schema=prisma/production/schema.prisma
#   npx prisma migrate deploy --schema=prisma/production/schema.prisma
#
# Si DATABASE_URL est absente en production, le build/déploiement doit échouer
# explicitement (comportement par défaut de `prisma migrate deploy`).

# --- WEB PUSH (Story 3.1) ---
# Générer une paire de clés (une seule fois, à conserver -- régénérer invalide
# tous les abonnements existants) : `npx web-push generate-vapid-keys`.
# Les deux restent des variables serveur uniquement (jamais NEXT_PUBLIC_) --
# app/reglages/page.tsx lit VAPID_PUBLIC_KEY côté serveur et la transmet en
# prop au composant client qui en a besoin pour `pushManager.subscribe()`,
# plutôt que de l'exposer au bundle client.
VAPID_PUBLIC_KEY="<clé publique générée>"
VAPID_PRIVATE_KEY="<clé privée générée -- jamais commitée, jamais journalisée>"
# Contact affiché aux fournisseurs de push (Google/Mozilla) en cas de souci --
# une adresse mailto: ou une URL, jamais laissé vide.
VAPID_SUBJECT="mailto:contact@example.com"
# Secret partagé avec Vercel Cron (voir vercel.json) -- protège
# app/api/cron/[moment]/route.ts contre un appel public non autorisé.
# Sur Vercel, Vercel Cron l'envoie automatiquement si cette variable existe.
CRON_SECRET="<chaîne aléatoire longue>"
